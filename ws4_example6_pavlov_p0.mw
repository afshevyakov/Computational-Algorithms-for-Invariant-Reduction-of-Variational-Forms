<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Multiplier psi^p = (-u4_x, u3_x, -u2_x, u1_x), Example 6.
psi1 := -u4[2]:  psi2 := u3[2]:  psi3 := -u2[2]:  psi4 := u1[2]:</Text-field>
</Input>
</Group>
</Section>
<Section collapsed="false" isCollapsible="true" drawButton="true" MultipleChoiceAnswerIndex="-1" MultipleChoiceRandomizeChoices="false" TrueFalseAnswerIndex="-1" EssayAnswerRows="5" EssayAnswerColumns="60"><Title><Text-field style="Heading 2" layout="Heading 2">Setup</Text-field></Title>
<Group hide-input="false" labelreference="L6" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">n := nops(independent_variables):  mpo := m + 1:
dependent_variables := seq(u||i,  i = 1..m):
aux_variables       := seq(FF||i, i = 1..m):
DGsetup(independent_variables, [dependent_variables, aux_variables], J, K):
Volume_form := 1:
for var in independent_variables do
   Volume_form := evalDG(Volume_form &amp;wedge D||var):
end do:
for i from 1 to m do f||i := expand(u||i[1] - F_form||i): end do:</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L7" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># OnShell: eliminate t-derivatives of u via F = 0 and consequences.
OnShell := proc(expr)
      local res, oldres, i, var, idx, pos, idx_red;
   res := expand(expr);
   do
      oldres := res;
      for i from 1 to m do
         for var in indets(res, specindex(u||i)) do
            idx := [op(var)];
            if member(1, idx, 'pos') then
               idx_red := subsop(pos = NULL, idx);
               if nops(idx_red) = 0 then res := subs(var = f||i, res);
               else res := subs(var = TotalDiff(f||i, idx_red), res); end if;
            end if;
         end do;
      end do;
      res := expand(res);
      if res = oldres then break; end if;
   end do;
   return simplify(res);
end proc:</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L8" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># AdjointStar(j): j-th component of l*_phi(psi), from the defining formula
#   sum_alpha (-1)^|alpha| D_alpha( (d phi^i/d u^j_alpha) psi_i )   (off-shell); cf. Remark 8.
AdjointStar := proc(j)
      local res, i, var, alpha, g;
   res := 0;
   for i from 1 to m do
      for var in indets(phi0||i, specindex(u||j)) do
         alpha := [op(var)];
         g := diff(phi0||i, var) * psi||i;
         if nops(alpha) = 0 then res := res + g;
         else res := res + (-1)^nops(alpha) * TotalDiff(g, alpha); end if;
      end do;
   end do;
   return expand(res);
end proc:</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L9" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Higher symmetry (5.11): phi^1 = phi^2 = 0, phi^3 as in Example 6, phi^4 = D_t(phi^3)|_E
# (on-shell elimination of t-derivatives).
phi01 := 0:  phi02 := 0:
phi03 := u1[2,2,3] + u1[2,2,2]*(u2[] + u1[2]^2)
   + u1[2,2]*(u2[2] + u1[2]*u1[2,2]) + u1[2]*u2[2,2]:
phi04 := OnShell( TotalDiff(phi03, [1]) ):</Text-field>
</Input>
</Group>
</Section>
<Section collapsed="false" isCollapsible="true" drawButton="true" MultipleChoiceAnswerIndex="-1" MultipleChoiceRandomizeChoices="false" TrueFalseAnswerIndex="-1" EssayAnswerRows="5" EssayAnswerColumns="60"><Title><Text-field style="Heading 2" layout="Heading 2">Step A: multiplier check</Text-field></Title>
<Group hide-input="false" labelreference="L10" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># CHECK 1 (expect m zeros): Euler operators annihilate psi_i F^i (psi is a multiplier).
EL_multiplier := EulerLagrange( add(psi||i * F_form||i, i = 1..m) ):
seq(simplify(EL_multiplier[j]), j = 1..m);</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">NiYiIiFGI0YjRiM=</Equation></Text-field>
</Output>
</Group>
</Section>
<Section collapsed="false" isCollapsible="true" drawButton="true" MultipleChoiceAnswerIndex="-1" MultipleChoiceRandomizeChoices="false" TrueFalseAnswerIndex="-1" EssayAnswerRows="5" EssayAnswerColumns="60"><Title><Text-field style="Heading 2" layout="Heading 2">Step B: flux form</Text-field></Title>
<Group hide-input="false" labelreference="L11" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># d_h(omega_hat) = psi_i F^i vol, i.e. eq. (5.3) at p = 0; omega_hat of Example 6.
CL_divergence := evalDG( add(psi||i * F_form||i, i = 1..m) &amp;wedge Volume_form ):
omega_hat := HorizontalHomotopy(CL_divergence);</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L12" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># CHECK 2 (expect 0).
evalDG( HorizontalExteriorDerivative(omega_hat) - CL_divergence );</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="LUkjbW5HNiMvSSttb2R1bGVuYW1lRzYiSSxUeXBlc2V0dGluZ0dJKF9zeXNsaWJHRic2JFEiMEYnLyUsbWF0aHZhcmlhbnRHUSdub3JtYWxGJw==">IiIh</Equation></Text-field>
</Output>
</Group>
</Section>
<Section collapsed="false" isCollapsible="true" drawButton="true" MultipleChoiceAnswerIndex="-1" MultipleChoiceRandomizeChoices="false" TrueFalseAnswerIndex="-1" EssayAnswerRows="5" EssayAnswerColumns="60"><Title><Text-field style="Heading 2" layout="Heading 2">Step C: invariance of the conservation law</Text-field></Title>
<Group hide-input="false" labelreference="L13" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Algorithm 1, Step 1 (invariance check), eq. (5.8) at p = 0.
# CHECK 3 (expect m zeros): E_phi(psi) + l*_phi(psi) = 0 on E.
E_phi := Prolong( add(evalDG(phi0||i * D_u||i[]), i = 1..m), K ):
seq( OnShell( LieDerivative(E_phi, psi||j) + AdjointStar(j) ), j = 1..m );</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">NiYiIiFGI0YjRiM=</Equation></Text-field>
</Output>
</Group>
</Section>
<Section collapsed="false" isCollapsible="true" drawButton="true" MultipleChoiceAnswerIndex="-1" MultipleChoiceRandomizeChoices="false" TrueFalseAnswerIndex="-1" EssayAnswerRows="5" EssayAnswerColumns="60"><Title><Text-field style="Heading 2" layout="Heading 2">Step D: integration by parts (Algorithm 1, Step 2, eq. (5.5))</Text-field></Title>
<Group hide-input="false" labelreference="L14" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Bilinear expression, with F represented by auxiliary variables FF.
E_FF := Prolong( add(evalDG(FF||i[] * D_u||i[]), i = 1..m), K ):
IBP_expr := expand(
   add( LieDerivative(E_FF, phi0||j) * psi||j, j = 1..m )
   - add( FF||j[] * AdjointStar(j), j = 1..m ) ):</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L15" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># CHECK 4 (expect 2m zeros): a total divergence has vanishing Euler derivatives.
EL_ibp := EulerLagrange(IBP_expr):
seq(simplify(EL_ibp[j]), j = 1..2*m);</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">NioiIiFGI0YjRiNGI0YjRiNGIw==</Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L16" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># FF-jets -&gt; Cartan forms; integrate by parts via horizontal homotopy.
Replace_FF_by_CFF := proc(expr)
      local res, i, var;
   res := 0;
   for i from 1 to m do
      for var in indets(expr, specindex(FF||i)) do
         res := res + diff(expr, var) * CFF||i[op(var)];
      end do;
   end do;
   return evalDG(res);
end proc:
IBP_form := Replace_FF_by_CFF(IBP_expr):
AF_CF := HorizontalHomotopy( evalDG(IBP_form &amp;wedge Volume_form) ):
# CHECK 5 (expect 0).
evalDG( IBP_form &amp;wedge Volume_form - HorizontalExteriorDerivative(AF_CF) );</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="LUkjbW5HNiMvSSttb2R1bGVuYW1lRzYiSSxUeXBlc2V0dGluZ0dJKF9zeXNsaWJHRic2JFEiMEYnLyUsbWF0aHZhcmlhbnRHUSdub3JtYWxGJw==">IiIh</Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L17" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Restore FF from Cartan forms.
Restore_field := Prolong( add(evalDG(FF||i[] * D_FF||i[]), i = 1..m), K ):
AF_aux := evalDG( -Hook(Restore_field, AF_CF) ):
# CHECK 6 (expect 0).
evalDG( IBP_expr &amp;wedge Volume_form - HorizontalExteriorDerivative(AF_aux) );</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="LUkjbW5HNiMvSSttb2R1bGVuYW1lRzYiSSxUeXBlc2V0dGluZ0dJKF9zeXNsaWJHRic2JFEiMEYnLyUsbWF0aHZhcmlhbnRHUSdub3JtYWxGJw==">IiIh</Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L18" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Substitute the actual F^i (coefficient-wise; internal degree 0).
SubsFF := proc(g)
      local res, i, var, idx;
   res := g;
   for i from 1 to m do
      for var in indets(res, specindex(FF||i)) do
         idx := [op(var)];
         if nops(idx) = 0 then res := subs(var = F_form||i, res);
         else res := subs(var = TotalDiff(F_form||i, idx), res); end if;
      end do;
   end do;
   return expand(res);
end proc:
AF := DifferentialGeometry:-Tools:-DGmap(1, SubsFF, AF_aux):</Text-field>
</Input>
</Group>
