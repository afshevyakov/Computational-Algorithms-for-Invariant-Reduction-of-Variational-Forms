<Group hide-input="false" labelreference="L4" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">F_form1 := u1[1] - u2[];
F_form2 := u2[1] - u1[2,3] - u2[]*u1[2,2] + u1[2]*u2[2];
