<Section collapsed="false" isCollapsible="true" drawButton="true" MultipleChoiceAnswerIndex="-1" MultipleChoiceRandomizeChoices="false" TrueFalseAnswerIndex="-1" EssayAnswerRows="5" EssayAnswerColumns="60"><Title><Text-field style="Heading 2" layout="Heading 2">Jet space setup</Text-field></Title>
<Group hide-input="false" labelreference="L4" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">n := nops(independent_variables):
dependent_variables := seq(u||i, i=1..m):
odd_variables := seq(q||i, i=1..m):</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L5" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">lhs_variables := seq(F0||i, i=1..m), seq(F1||i, i=1..m):
psi_variables := seq(pmo_psi||i, i=1..m), seq(p_psi||i, i=1..m):
mpo := m+1:</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L6" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">DGsetup(independent_variables, [dependent_variables, odd_variables,
   lhs_variables, psi_variables], J, K):
Volume_form := 1:
for var in independent_variables do
   Volume_form := evalDG(Volume_form &amp;wedge D||var):
end do:</Text-field>
</Input>
</Group>
</Section>
<Section collapsed="false" isCollapsible="true" drawButton="true" MultipleChoiceAnswerIndex="-1" MultipleChoiceRandomizeChoices="false" TrueFalseAnswerIndex="-1" EssayAnswerRows="5" EssayAnswerColumns="60"><Title><Text-field style="Heading 2" layout="Heading 2">Equations and tangent system</Text-field></Title>
<Group hide-input="false" labelreference="L7" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">F0_form1 := u1[1] - u1[2]^2 - u1[2,2,2] - u1[2,2,3];</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LV9JLFR5cGVzZXR0aW5nRzYkJSpwcm90ZWN0ZWRHSShfc3lzbGliRzYiSSxtcHJpbnRzbGFzaEdGKDYkNyM+SSlGMF9mb3JtMUdGKCwqKiQmSSN1MUdGKDYjIiIjRjMhIiImRjE2IyIiIkY3JkYxNiVGM0YzRjNGNCZGMTYlRjNGMyIiJEY0NyNGLg==</Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L8" drawlabel="true" applyint="true" applyrational="true">
