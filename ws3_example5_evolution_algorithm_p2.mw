<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">E_phi :=
   Prolong(
   add(evalDG(phi0||i*D_u||i[]), i=1..m),
   K):
Lie_omega_hat :=
   evalDG(
   Hook(E_phi, VerticalExteriorDerivative(omega_hat)) +
   `if`(p=0, 0, VerticalExteriorDerivative(Hook(E_phi, omega_hat)))
