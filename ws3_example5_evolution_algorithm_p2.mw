   &amp;wedge _DG([[&quot;biform&quot;,J,[n-1, 0]],[[op([1,2,i,1],AF_incomplete),1]]]),
   i=1..nops(op([1,2], AF_incomplete))
   ):</Text-field>
</Input>
</Group>
