<Group hide-input="false" labelreference="L20" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Impose phi = 0 (here: u_xxx = -(u+c) u_x and consequences).
ReduceEX := proc(expr)
      local res, oldres, var, idx, kk;
   res := expand(expr);
   do
      oldres := res;
      for var in indets(res, specindex(u1)) do
         idx := [op(var)];
         if nops(idx) &gt;= 3 and convert(idx, set) = {2} then
            if nops(idx) = 3 then res := subs(var = -(u1[] + c)*u1[2], res);
            else res := subs(var = TotalDiff(-(u1[] + c)*u1[2],
                  [seq(2, kk = 1..nops(idx) - 3)]), res); end if;
         end if;
      end do;
      res := expand(res);
      if res = oldres then break; end if;
   end do;
   return simplify(res);
end proc:
vartheta_reduced := ReduceEX(vartheta_on_E);
# expect (up to sign, additive const): u^3/3 + u u_xx - u_x^2/2 + c u^2/2, i.e. I_2 of eq. (8.2)</Text-field>
</Input>
