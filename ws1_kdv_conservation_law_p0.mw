<Group hide-input="false" labelreference="L9" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># d_h(omega_hat) = psi_i F^i vol, i.e. eq. (5.3) at p = 0.
