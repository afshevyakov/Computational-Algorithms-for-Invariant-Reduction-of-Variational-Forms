<Group hide-input="false" labelreference="L11" drawlabel="true" applyint="true" applyrational="true">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Algorithm 1, Step 1 (invariance check), eq. (5.8) at p = 0.
# CHECK 3 (expect m zeros): E_phi(psi) + l*_phi(psi) = 0 on E.
E_phi := Prolong( add(evalDG(phi0||i * D_u||i[]), i = 1..m), K ):
seq( OnShell( LieDerivative(E_phi, psi||j) + AdjointStar(j) ), j = 1..m );</Text-field>
