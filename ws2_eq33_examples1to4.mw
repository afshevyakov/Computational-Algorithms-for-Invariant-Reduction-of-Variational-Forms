<Section collapsed="false" isCollapsible="true" drawButton="true" MultipleChoiceAnswerIndex="-1" MultipleChoiceRandomizeChoices="false" TrueFalseAnswerIndex="-1" EssayAnswerRows="5" EssayAnswerColumns="60"><Title><Text-field style="Heading 1" layout="Heading 1">WS2 -- Equation (3.3): Examples 1-4 (verification)</Text-field></Title>
<Section collapsed="false" isCollapsible="true" drawButton="true" MultipleChoiceAnswerIndex="-1" MultipleChoiceRandomizeChoices="false" TrueFalseAnswerIndex="-1" EssayAnswerRows="5" EssayAnswerColumns="60"><Title><Text-field style="Heading 2" layout="Heading 2">Setup</Text-field></Title>
<Group hide-input="false" labelreference="L2" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart;
# WS2: verification of Examples 1-4 (Section 3) and Section 8.2 for
# u_t = u_x^2 + u_xxx + u_xxy, eq. (3.3).
# v1 = auxiliary (symbolic) characteristic chi; Cartan forms Cu1[..] = theta_alpha
# represent the odd variables q_alpha (Section 3.2, Appendix A).
# All CHECKs must print 0 (6 checkpoints).
with(DifferentialGeometry): with(JetCalculus):
m := 1:  K := 8:
DGsetup([t, x, y], [u1, v1], J, K):
Vol := evalDG(Dt &amp;wedge Dx &amp;wedge Dy):
F_form1 := u1[1] - u1[2]^2 - u1[2,2,2] - u1[2,2,3];
f1 := expand(u1[1] - F_form1):</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LV9JLFR5cGVzZXR0aW5nRzYkJSpwcm90ZWN0ZWRHSShfc3lzbGliRzYiSSxtcHJpbnRzbGFzaEdGKDYkNyM+SShGX2Zvcm0xR0YoLCoqJCZJI3UxR0YoNiMiIiNGMyEiIiZGMTYjIiIiRjcmRjE2JUYzRjNGM0Y0JkYxNiVGM0YzIiIkRjQ3I0Yu</Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L3" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># OnShell: eliminate t-derivatives of u via F = 0 and consequences.
OnShell := proc(expr)
      local res, oldres, i, var, idx, pos, idx_red;
   res := expand(expr);
   do
      oldres := res;
      for i from 1 to m do
         for var in indets(res, specindex(u||i)) do
            idx := [op(var)];
            if member(1, idx, 'pos') then
               idx_red := subsop(pos = NULL, idx);
               if nops(idx_red) = 0 then res := subs(var = f||i, res);
               else res := subs(var = TotalDiff(f||i, idx_red), res); end if;
            end if;
         end do;
      end do;
      res := expand(res);
      if res = oldres then break; end if;
   end do;
   return simplify(res);
end proc:</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L4" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Adjoint linearization of F applied to psi (off-shell).
AdjLinF := proc(psi)
      local res, var, alpha;
   res := 0;
   for var in indets(F_form1, specindex(u1)) do
      alpha := [op(var)];
      if nops(alpha) = 0 then res := res + diff(F_form1, var)*psi;
      else res := res + (-1)^nops(alpha)*TotalDiff(diff(F_form1, var)*psi, alpha);
      end if;
   end do;
   return expand(res);
end proc:</Text-field>
</Input>
</Group>
</Section>
<Section collapsed="false" isCollapsible="true" drawButton="true" MultipleChoiceAnswerIndex="-1" MultipleChoiceRandomizeChoices="false" TrueFalseAnswerIndex="-1" EssayAnswerRows="5" EssayAnswerColumns="60"><Title><Text-field style="Heading 2" layout="Heading 2">Example 1: the cosymmetry (3.5)</Text-field></Title>
<Group hide-input="false" labelreference="L5" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">psi1 := 3*t*u1[1,2] + x*u1[2,2] + y*u1[2,3] + 2*u1[2];
# CHECK 1 (expect 0): l*_F(psi) vanishes on E.
OnShell( AdjLinF(psi1) );</Text-field>
</Input>
